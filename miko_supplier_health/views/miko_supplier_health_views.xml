<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_supply_health_list" model="ir.ui.view">
        <field name="name">product.template.supply.health.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Supply Health" default_order="sh_supply_status,name" create="false">
                <field name="name" readonly="1"/>
                <field name="sh_supply_status" readonly="1"
                       decoration-danger="sh_supply_status in ('no_supplier','all_expired')"
                       decoration-warning="sh_supply_status == 'no_price'"
                       decoration-muted="sh_supply_status in ('ok','na')"/>
                <field name="sh_lead_time" readonly="1" optional="show"/>
                <field name="standard_price" optional="hide"/>
                <field name="categ_id" optional="hide"/>
                <field name="sh_is_healthy" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_supply_health_search" model="ir.ui.view">
        <field name="name">product.template.supply.health.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Supply Health">
                <field name="name"/>
                <filter name="cannot_buy" string="Cannot Be Reordered"
                        domain="[('sh_supply_status','in',('no_supplier','all_expired'))]"
                        help="Marked as purchasable, but there is no supplier line Odoo can use."/>
                <filter name="no_supplier" string="No Supplier At All"
                        domain="[('sh_supply_status','=','no_supplier')]"/>
                <filter name="all_expired" string="Every Line Expired"
                        domain="[('sh_supply_status','=','all_expired')]"/>
                <filter name="no_price" string="Supplier Has No Price"
                        domain="[('sh_supply_status','=','no_price')]"/>
                <group>
                    <filter name="g_status" string="Supply Check"
                            context="{'group_by': 'sh_supply_status'}"/>
                    <filter name="g_categ" string="Product Category"
                            context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_supply_health" model="ir.actions.act_window">
        <field name="name">Products You Cannot Reorder</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_supply_health_list"/>
        <field name="search_view_id" ref="view_supply_health_search"/>
        <field name="context">{'search_default_cannot_buy': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Everything you buy has a supplier Odoo can use.</p>
            <p>Just installed? Run <b>Supplier Health &gt; Recheck Supply</b> once.</p>
        </field>
    </record>

    <record id="view_supplier_line_health_list" model="ir.ui.view">
        <field name="name">product.supplierinfo.health.list</field>
        <field name="model">product.supplierinfo</field>
        <field name="arch" type="xml">
            <list string="Supplier Lines" default_order="partner_id,sequence" create="false">
                <field name="partner_id"/>
                <field name="product_tmpl_id" optional="show"/>
                <field name="min_qty"/>
                <field name="price"/>
                <field name="delay" optional="show"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="sh_line_status"
                       decoration-danger="sh_line_status == 'unreachable'"
                       decoration-warning="sh_line_status in ('expired','no_price')"
                       decoration-muted="sh_line_status in ('ok','future')"/>
                <field name="sh_shadowed_by" string="Beaten by"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_line_health_search" model="ir.ui.view">
        <field name="name">product.supplierinfo.health.search</field>
        <field name="model">product.supplierinfo</field>
        <field name="arch" type="xml">
            <search string="Supplier Lines">
                <field name="partner_id"/>
                <filter name="dead" string="Never Used"
                        domain="[('sh_line_status','=','unreachable')]"
                        help="Another line always wins, so Odoo can never select this one."/>
                <filter name="expired" string="Expired"
                        domain="[('sh_line_status','=','expired')]"/>
                <filter name="no_price" string="No Price"
                        domain="[('sh_line_status','=','no_price')]"/>
                <group>
                    <filter name="g_partner" string="Supplier"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="g_status" string="Line Check"
                            context="{'group_by': 'sh_line_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_supplier_line_health" model="ir.actions.act_window">
        <field name="name">Supplier Price Lines</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_supplier_line_health_list"/>
        <field name="search_view_id" ref="view_supplier_line_health_search"/>
        <field name="context">{'search_default_dead': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every supplier line can be reached.</p>
            <p>Odoo takes the first line that fits, so a line behind one already
               covering the same ground never gets used.</p>
        </field>
    </record>

    <record id="action_supply_rescan" model="ir.actions.server">
        <field name="name">Recheck Supply</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">action = model.action_supply_health_rescan()</field>
    </record>
    <record id="action_lines_rescan" model="ir.actions.server">
        <field name="name">Recheck Supplier Lines</field>
        <field name="model_id" ref="product.model_product_supplierinfo"/>
        <field name="state">code</field>
        <field name="code">action = model.action_supplier_lines_rescan()</field>
    </record>

    <menuitem id="menu_supplier_health_root" name="Supplier Health"
              web_icon="miko_supplier_health,static/description/icon.png" sequence="98"/>
    <menuitem id="menu_supply_products" name="Products You Cannot Reorder"
              parent="menu_supplier_health_root" action="action_supply_health" sequence="10"/>
    <menuitem id="menu_supplier_lines" name="Supplier Price Lines"
              parent="menu_supplier_health_root" action="action_supplier_line_health" sequence="20"/>
    <menuitem id="menu_supply_rescan" name="Recheck Supply"
              parent="menu_supplier_health_root" action="action_supply_rescan" sequence="30"/>
    <menuitem id="menu_lines_rescan" name="Recheck Supplier Lines"
              parent="menu_supplier_health_root" action="action_lines_rescan" sequence="40"/>

</odoo>
